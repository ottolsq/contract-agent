# 复制为 .env 后填写，.env 不要提交到 git

# 模型服务 API Key；只放在本地 .env，不要写进代码或笔记
LLM_API_KEY=

# OpenAI 兼容接口地址；DeepSeek 官方为 https://api.deepseek.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名称；以服务商文档为准，例如 deepseek-chat
LLM_MODEL=deepseek-chat

# 输出随机性，范围 0-2：越低越稳定、越可复现
# 合同审查、法条引用建议 0-0.2；不要为了"更聪明"调高，温度不提升准确性
LLM_TEMPERATURE=0.2

# 单次请求超时时间（秒）
LLM_TIMEOUT=60

# 单次输出 token 上限，防止长报告无界生成
LLM_MAX_TOKENS=4096

# 瞬时故障的最大重试次数：只对 429 / 5xx / 连接错误生效
# 400 参数错、401 鉴权、上下文超长这类确定性错误不会重试
# 流式已输出内容后不会回退重试（否则用户会看到重复内容）
LLM_MAX_RETRIES=3

# 向量库持久化目录
CHROMA_DIR=data/chroma

# 启动时预加载 embedding 模型（约 10 秒，换来首个请求不等待）
# 用 --reload 开发时建议设为 false，避免每次热重载都重新加载
WARMUP_ON_STARTUP=true

# 检索模式：hybrid = 向量 + BM25 融合（默认，评测最优）；dense 只走向量；bm25 只走词面
RETRIEVAL_MODE=hybrid

# 融合权重：给 BM25 的比重，0 = 纯向量，1 = 纯词面
# 0.7 是评测集上留一法交叉验证选出来的，改动前请重跑 scripts/evaluate.py 对比
HYBRID_BM25_WEIGHT=0.7

# 融合前向量侧多取的候选数；BM25 侧覆盖域内全部法条
HYBRID_CANDIDATES=100

# 法条语料路径（BM25 索引与评测共用）
LAWS_JSONL=data/processed/laws.jsonl

# embedding 模型下载源：国内默认走 hf-mirror.com（代码中已设默认值，一般不用改）
# HF_ENDPOINT=https://hf-mirror.com
