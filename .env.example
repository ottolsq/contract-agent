# 复制为 .env 后填写，.env 不要提交到 git

# 模型服务 API Key；只放在本地 .env，不要写进代码或笔记
LLM_API_KEY=

# OpenAI 兼容接口地址；DeepSeek 官方为 https://api.deepseek.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名称；以服务商文档为准，例如 deepseek-chat
LLM_MODEL=deepseek-chat

# 输出随机性，范围 0-2：越低越稳定、越可复现
# 合同审查、法条引用建议 0-0.2；不要为了"更聪明"调高，温度不提升准确性
LLM_TEMPERATURE=0.2

# 单次请求超时时间（秒）
LLM_TIMEOUT=60

# 瞬时故障的最大重试次数：只对 429 / 5xx / 连接错误生效
# 400 参数错、401 鉴权、上下文超长这类确定性错误不会重试
# 流式已输出内容后不会回退重试（否则用户会看到重复内容）
LLM_MAX_RETRIES=3
